  },
  "homepage": "https://github.com/shiliuyu316/dsh-optimization-2027#readme",
  "bugs": {
    "url": "https://github.com/shiliuyu316/dsh-optimization-2027/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
